16. Blocking session details (RAC)
SELECT s1.username || '@' || s1.machine ||
       ' (SID=' || s1.sid || ' from Inst=' || s1.inst_id || ')' ||
       ' is blocking ' ||
       s2.username || '@' || s2.machine ||
