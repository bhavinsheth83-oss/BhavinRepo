47. SQL statistics from AWR
SELECT s.parsing_schema_name,
       ss.snap_id,
       ss.instance_number AS node,
       ss.begin_interval_time,
       s.sql_id,
       s.plan_hash_value,
       NVL(s.executions_delta, 0) AS executions,
       (s.elapsed_time_delta /
          DECODE(NVL(s.executions_delta, 0), 0, 1, s.executions_delta))
          / 1000000 AS avg_time,
       s.buffer_gets_delta /
          DECODE(NVL(s.executions_delta, 0), 0, 1, s.executions_delta) AS avg_io,
       ROUND(s.rows_processed_delta /
          DECODE(NVL(s.executions_delta, 0), 0, 1, s.executions_delta)) AS rows_per_exec
FROM   dba_hist_sqlstat s,
       dba_hist_snapshot ss
WHERE  s.sql_id = '2k5s7v1qxxv23'
AND    ss.snap_id = s.snap_id
AND    ss.instance_number = s.instance_number
AND    s.executions_delta > 0
ORDER BY 1, 2, 3;
48. SQL performance metrics by plan hash value
SELECT sql_id,
       inst_id,
       LPAD(plan_hash_value, 15) || '-CURRENT' AS plan_hash_value,
       SUM(executions) AS executions,
       ROUND(SUM(rows_processed) / (SUM(executions) + .0001), 2)
           AS rows_prsd_per_exec,
       ROUND(SUM(disk_reads) / (SUM(executions) + .0001), 2)
           AS phy_io_per_exec,
       ROUND(SUM(buffer_gets) / (SUM(executions) + .0001), 2)
           AS lio_per_exec,
       ROUND(SUM(cpu_time) / 1000000 /
          (CASE WHEN SUM(executions) = 0 THEN 1 ELSE SUM(executions) END), 2)
           AS cpu_time_per_exec_secs,
       ROUND(SUM(elapsed_time) / 1000000 /
          (CASE WHEN SUM(executions) = 0 THEN 1 ELSE SUM(executions) END), 2)
           AS elap_time_per_exec_secs,
       sql_profile
FROM   gv$sql
WHERE  sql_id = 'bufyqru09r04t'
GROUP BY sql_id, inst_id, plan_hash_value, sql_profile;
