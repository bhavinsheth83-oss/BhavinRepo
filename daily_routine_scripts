23. Tablespace allocation, usage and maximum capacity
SELECT a.tablespace_name,
       a.allo AS allo_g,
       ROUND(a.allo - b.free, 2) AS used_g,
       ROUND(b.free, 2) AS free_g,
       a.max AS max_g,
       ROUND((a.max - a.allo + b.free), 2) AS max_free_g,
       ROUND(100 * ((a.max - a.allo + b.free) / a.max), 2) AS max_free_percent
FROM   (SELECT tablespace_name,
               SUM(bytes) / 1024 / 1024 / 1024 AS allo,
               SUM(DECODE(maxbytes, NULL, bytes, 0, bytes, maxbytes))
                   / 1024 / 1024 / 1024 AS max
        FROM   dba_data_files
        GROUP BY tablespace_name) a,
       (SELECT tablespace_name,
               SUM(bytes) / 1024 / 1024 / 1024 AS free
        FROM   dba_free_space
        GROUP BY tablespace_name) b
WHERE  a.tablespace_name = b.tablespace_name
AND    a.tablespace_name NOT LIKE 'TEMP%'
ORDER BY 100 * ((a.max - a.allo + b.free) / a.max);
