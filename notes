register extract EX11TO12 database 
alter extract EX11TO12 scn 12503878301058.
start extract EX11TO12




// to start data pump with particular scn
alter DP11TO12 scn 12503878301058.

// to start pump from a particular sequence number and RBA
ALTER EXTRACT <pump_name> EXTSEQNO 00
ALTER EXTRACT <pump_name> EXTRBA 0




