// To find change in plan hash value
select distinct 
a.SQL_ID, a.PLAN_HASH_VALUE new_plan, b.PLAN_HASH_VALUE old_plan, 
(a.elapsed_time_delta/1000000)/decode(a.executions_delta,0,1,a.executions_delta) "new_time",
(b.elapsed_time_delta/1000000)/decode(b.executions_delta,0,1,b.executions_delta) "old_time"
from dba_hist_sqlstat a, dba_hist_sqlstat b where 
a.SNAP_ID in (select snap_id from dba_hist_snapshot where trunc(BEGIN_INTERVAL_TIME) >= '11-JUN-2017') 
and b.SNAP_ID in (select snap_id from dba_hist_snapshot where trunc(BEGIN_INTERVAL_TIME) < '11-JUN-2017' and trunc(BEGIN_INTERVAL_TIME) > '04-JUN-2017' )  
and 
a.PARSING_SCHEMA_NAME in ('SIEBEL','SADMIN','PROXYOUI','PROXYEMP','PROXYBTW') and
a.sql_id = b.sql_id and a.PLAN_HASH_VALUE != b.PLAN_HASH_VALUE and
a.PARSING_SCHEMA_NAME=b.PARSING_SCHEMA_NAME
and 
(a.elapsed_time_delta/1000000)/decode(a.executions_delta,0,1,a.executions_delta) < 7
and 
(a.elapsed_time_delta/1000000)/decode(a.executions_delta,0,1,a.executions_delta) >
(b.elapsed_time_delta/1000000)/decode(b.executions_delta,0,1,b.executions_delta) 
order by a.sql_id 



// To find change in plan hash value
