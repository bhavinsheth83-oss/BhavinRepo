// Get trial execution details (OSPUG)

SQL> select TASK_NAME,EXECUTION_NAME,EXECUTION_TYPE,PLAN_HASH_VALUE,ELAPSED_TIME,BUFFER_GETS,FETCHES,ROWS_PROCESSED,EXECUTIONS 
from dba_advisor_sqlstats where sql_id='&sql_id';


// Get live execution details (OSPUG)
col action for a20
col module for a30
select PLAN_HASH_VALUE,MODULE,ACTION,ELAPSED_TIME,BUFFER_GETS,FETCHES,ROWS_PROCESSED,EXECUTIONS 
from dba_sqlset_statements where sql_id='&sql_id';


// To find various details of SQL_ID for SPA(plan hash value, buffer gets) Pre trial and Post trial( Run on OSUPG)
select TASK_NAME,EXECUTION_NAME,EXECUTION_TYPE,PLAN_HASH_VALUE,ELAPSED_TIME,BUFFER_GETS,ROWS_PROCESSED,EXECUTIONS from 
dba_advisor_sqlstats where sql_id = '&sqlid' and TASK_NAME like '%TASK%' order by TASK_NAME


// To know number of rows, sample size and percentage for generating stats
select TABLE_NAME,NUM_ROWS,SAMPLE_SIZE,round((SAMPLE_SIZE*100/NUM_ROWS))
from dba_tab_statistics where OWNER='SIEBEL'
and table_name = '&tname'; 


// To generate stats.
EXEC DBMS_STATS.GATHER_TABLE_STATS('SIEBEL', 'S_ADDR_PER_X', 	estimate_percent => 100, 	method_opt => 'FOR ALL INDEXED COLUMNS SIZE 254', degree => DBMS_STATS.DEFAULT_DEGREE, cascade => TRUE); 


// To know when the stats was last analyzed.
select trunc(last_analyzed),count(1) from dba_tables where owner='SIEBEL' group by trunc(last_analyzed) order by 1;
select OWNER,TABLE_NAME,NUM_ROWS,SAMPLE_SIZE,LAST_ANALYZED from dba_tab_statistics where owner='SIEBEL'  order by TABLE_NAME ;

// To know which SQL is running against that particular table
select SQL_ID from dba_hist_sqltext where SQL_TEXT like '%CX_INTF_LOG_BT%';

// ORA-13757 error solution:
// this will give you tuning_task task name which u have to drop 
select description, created, owner 
from DBA_SQLSET_REFERENCES 
where sqlset_name = '<sqlset_name>';

// to drop tuning task
exec DBMS_SQLTUNE.DROP_TUNING_TASK(task_name => '<task_name>');

// to drop sqlset
exec dbms_sqltune.drop_sqlset(sqlset_name => '<sqlset_name>');

// to find tuning task created for SQL tuning advisor
SELECT task_name, status, owner FROM dba_advisor_log where owner not in('SYS');

