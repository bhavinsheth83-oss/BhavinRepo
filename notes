// To check how many SPBs are in use

set heading on
prompt
prompt SPB used Details:
prompt ~~~~~~~~~~~~~~~~~
prompt
select
'SQL PLAN BASE LINES INFO: ' " ",
max(case when TOT=1 then CNT end ) as TOTAL,
max(case when TOT=2 then CNT end ) as USED
from
(select 1 TOT,count(distinct SQL_HANDLE) CNT from dba_sql_plan_baselines
union
select 2 TOT,count(distinct SQL_HANDLE ) CNT from dba_sql_plan_baselines
where LAST_EXECUTED is not null
);

