SELECT SQL_ID, PARSING_SCHEMA_NAME AS "SCH", SQL_TEXT, 
       ELAPSED_TIME AS "ELAPSED", BUFFER_GETS
FROM   TABLE( DBMS_SQLTUNE.SELECT_SQLSET( 'LIVE1' ) );


-- query to fine full table scan
SELECT distinct sql_id FROM
( SELECT DISTINCT p.sql_id,					
    executions ,						
    elapsed_sec,						
    SORTS,							
    parse_calls,						
    buffer_gets,						
    disk_reads,						
    (BUFFER_GETS+DISK_READS) TOTAL_I_O,
	round((BUFFER_GETS+DISK_READS)/executions,0) IO_PER_EXEC,
    p.object_owner owner,					
    p.object_name name,					
    p.options OPTIONS					
FROM							
    (SELECT sql.sql_id SQLID,					
      SUM(sql.executions_delta) executions ,			
      ROUND(SUM(sql.elapsed_time_delta/1000000)) elapsed_sec,	
      SUM(sql.SORTS_DELTA) SORTS,				
      SUM(sql.PARSE_CALLS_DELTA) PARSE_CALLS,			
      SUM(sql.buffer_gets_delta) buffer_gets,			
      SUM(sql.disk_reads_delta) disk_reads			
    FROM dba_hist_sqlstat SQL,					
      dba_hist_snapshot s					
    WHERE sql.executions_delta > 0				
    AND s.snap_id              = sql.snap_id				
    AND s.begin_interval_time >= trunc(sysdate-7)
    AND s.end_interval_time   <= sysdate
    GROUP BY sql.sql_id					
    )a,							
    dba_hist_sql_plan p					
  WHERE a.sqlid   = p.sql_id					
  AND p.operation = 'TABLE ACCESS'				
  AND p.options   = 'FULL'
  AND p.object_owner in 
  ('JEOPARDY_MANAGEMENT','LINETEST_MANAGEMENT','MANAGE_APPOINTMENT','MANAGE_IRC_HANDLING','MANAGE_SYSTEM','MANAGE_UTILITY',
   'ORDER_FTTPPROVIDE','PLAN_BUILD_MANAGEMENT','RESOURCE_MANAGEMENT','STAA_SERVICE_MANAGEMENT','SUPPLEMENTARY_PROCESS',
   'TASK_MANAGEMENT','TASKTYPE_DERIVATION') 
  ORDER BY IO_PER_EXEC DESC));

################################################################################################################################################################
// To find the SQLs executed in specified time by snap idsnap id

SELECT TO_CHAR(sn.begin_interval_time,'DD:MON:YY HH24:MI:SS') timestamp,
  sql.INSTANCE_NUMBER,
  sql.PARSING_SCHEMA_NAME,
  sql.sql_id,
  sql.plan_hash_value,
  SUM(sql.EXECUTIONS_DELTA) execs,
  SUM(sql.DISK_READS_DELTA) disk,
  SUM(sql.BUFFER_GETS_DELTA) lio,
  SUM(sql.ROWS_PROCESSED_DELTA) rws,
  SUM(sql.CPU_TIME_DELTA    /1000000) cpu,
  SUM(sql.ELAPSED_TIME_DELTA/1000000) elapse
FROM dba_hist_sqlstat SQL,
  dba_hist_snapshot sn
WHERE sql.dbid =sn.dbid
AND sql.snap_id=sn.snap_id
AND sn.snap_id BETWEEN 266272 AND 266274
AND sql.sql_id = '0jtquvhma44sd'
GROUP BY TO_CHAR(sn.begin_interval_time,'DD:MON:YY HH24:MI:SS'),
  sql.PARSING_SCHEMA_NAME,
  sql.sql_id,
  sql.plan_hash_value,
  sql.INSTANCE_NUMBER
ORDER BY elapse DESC;

// Query to find high disk reads(Disk IO)
select 
   sql_id, 
  child_number, 
   sql_text, 
   disk_reads
from 
   (select 
     sql_id,child_number, 
      sql_text, 
     elapsed_time, 
      cpu_time, 
     disk_reads,
rank () over (order by disk_reads desc) as sql_rank from gv$sql)
where 
   sql_rank < 10;
   
//SQL query to locate historical SQL (over the past 40 days) that has an execution time greater than 20 wall clock seconds(elapsed time)   
(to check long running queries, Slow queries, performance related queries for specific time ex : SQLs greater than 30 secs , 60 secs, etc for last 7 days)
  select
   stat.sql_id, 
   plan_hash_value,
   rpad(parsing_schema_name,50) "schema",elapsed_time_total/1000000 "seconds",  
   elapsed_time_delta,disk_reads_delta,
   stat.executions_total,
   to_char(ss.end_interval_time,'dd-mm-yy hh24:mi:ss') "endtime", 
   sql_text,ss.snap_id
from
   dba_hist_sqlstat  stat,
   dba_hist_sqltext  txt,
   dba_hist_snapshot ss
where
   stat.sql_id = txt.sql_id
and
   stat.dbid = txt.dbid
and
   ss.dbid = stat.dbid
and
   ss.instance_number = stat.instance_number
and
   stat.snap_id = ss.snap_id
and
   parsing_schema_name not like 'SYS%' 
   and plan_hash_value!=0
and ss.begin_interval_time >= sysdate-7
and 
   stat.elapsed_time_total/1000000 > 30
   and sql_text like 'select%'
order by
   elapsed_time_total desc;
   
   
-- query to find total executions of particular sql and its average time   
select a.sql_id,a.plan_hash_value, sum(executions_delta),
sum(round(ELAPSED_TIME_delta/1000000/greatest(executions_delta,1),4)) "avg duration (sec)" from dba_hist_SQLSTAT a, dba_hist_snapshot b
where sql_id='d1u93xy3p3qgp' and a.snap_id=b.snap_id
--and a.sql_id=b.sql_id
and a.instance_number=b.instance_number
and executions_delta is not null
AND b.SNAP_ID BETWEEN (SELECT MIN(b.snap_id) FROM dba_hist_snapshot) AND (SELECT MAX(b.snap_id) FROM dba_hist_snapshot)
group by sql_id,plan_hash_value;

   
   
// query to find long running query for more than 20 secs   
select * from
(
  select distinct sql_id,
     opname,
     start_time,
     target,
     sofar,
     totalwork,
     units,
     elapsed_seconds,
     message
   from
        gv$session_longops
        where elapsed_seconds > 20
  order by elapsed_seconds desc
)
where rownum <=20;   


-- SQLs running for more than 30 secs
SELECT distinct s.username,Q.SQL_ID,round(s.last_call_et ,2) Time_in_seconds,round(s.last_call_et / 60,2) Time_in_mins,s.sid,s.serial#,s.inst_id
    FROM gv$session s
         JOIN gv$sqltext_with_newlines q ON s.sql_address = q.address
   WHERE status = 'ACTIVE' AND username like '%APPS%' AND TYPE <> 'BACKGROUND' AND s.last_call_et  > 30 
ORDER BY s.inst_id;

-- SQLs running for more than 30 secs
select sid, serial#, username, to_char(sysdate-last_call_et/24/60/60,'hh24:mi:ss') started,
trunc(last_call_et/60) || ' mins, ' || mod(last_call_et,60) ||
' secs' dur,
(select sql_text from gv$sql where address = sql_address ) sql_text
from gv$session
where username is not null
and last_call_et > 30
and status = 'ACTIVE';



// IO 
select min(begin_time), max(end_time),

       sum(case metric_name when 'Physical Read Total Bytes Per Sec' then average end) Physical_Read_Total_Bps,

       sum(case metric_name when 'Physical Write Total Bytes Per Sec' then average end) Physical_Write_Total_Bps,

       sum(case metric_name when 'Redo Generated Per Sec' then average end) Redo_Bytes_per_sec,

       sum(case metric_name when 'Physical Read Total IO Requests Per Sec' then average end) Physical_Read_IOPS,

       sum(case metric_name when 'Physical Write Total IO Requests Per Sec' then average end) Physical_write_IOPS,

       sum(case metric_name when 'Redo Writes Per Sec' then average end) Physical_redo_IOPS,

       sum(case metric_name when 'Current OS Load' then average end) OS_LOad,

       sum(case metric_name when 'CPU Usage Per Sec' then average end) DB_CPU_Usage_per_sec, 

       sum(case metric_name when 'Host CPU Utilization (%)' then average end) Host_CPU_util, --NOTE 100% = 1 loaded RAC node 

       sum(case metric_name when 'Network Traffic Volume Per Sec' then average end) Network_bytes_per_sec, 

       snap_id

from dba_hist_sysmetric_summary

group by snap_id

order by snap_id;

