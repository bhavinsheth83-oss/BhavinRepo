// Error: ORA-02391 exceeded simultaneous SESSIONS_PER_USER limit

To find resource limit use below query

col USERNAME for a20;
col PROFILE for a20;
col LIMIT for a20;
SELECT DISTINCT username, 
                profile, 
                resource_name, 
                limit
FROM   dba_profiles 
       NATURAL JOIN dba_users 
WHERE  resource_name = 'SESSIONS_PER_USER' 
       AND username = 'MBT';


