// To know proxy users in DB

select * from proxy_users



select username||','||account_status from dba_users where account_status <> 'OPEN' and username IN ('MORES2','SRIMS','ICM','ELK_USER','NETWORK_BUILD',
'OR_ODS','SRIMSOR_GWC','INVENTORY','SRIMS_PHX','SERVICE_ORDER','OR_DRA','SRIMS_DRA','CRAMER','SRIMSRO');

SELECT NVL(s.username, '(oracle)') AS username,s.osuser,s.sid,s.serial#,p.spid,s.lockwait,
	   s.status,s.module,s.machine,s.sql_id,s.program,
	   TO_CHAR(s.logon_Time,'DD-MON-YYYY HH24:MI:SS') AS logon_time,
	   s.last_call_et AS last_call_et_secs
FROM   gv$session s,
	   gv$process p
WHERE  s.paddr  = p.addr
and  s.username IN ('SRIMS','ICM','ELK_USER','NETWORK_BUILD','OR_ODS','SRIMSOR_GWC','INVENTORY','SRIMS_PHX','SERVICE_ORDER','OR_DRA','SRIMS_DRA','CRAMER','SRIMSRO')
--and  S.STATUS = 'ACTIVE'
--and s.machine IN ( 'dyl10800dat01','dyl10800dat02')
--and s.sid in ( 2309)
--and s.sid in (select distinct blocking_session from gv$session where blocking_session is not null)
-- and s.last_call_et > 240
and s.osuser not in ('saorsrms01','srimsor')
ORDER BY s.username, s.osuser; 
 

 
