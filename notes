// Index usage


col begin_interval_time for a20
col "gets" for9999999
col "PRS" for 9999999
col "elap" for 9999.99
col schema for a15
col exec for 999999
col sql_text for a40
col "ROWS" for 9999999
col module for a20
set linesize 200

select a.sql_id, to_char(begin_interval_time,'DD/MM/YYYY Hh24:MI') begin_interval,
   executions_delta exec,
  plan_hash_value,
  buffer_gets_delta/executions_delta "gets" ,
  rows_processed_delta/executions_delta "rows",
  (elapsed_time_delta/1000000)/executions_delta "elap",
  a.snap_id,
--  a.parsing_schema_name schema,
a.module,
  substr(c.sql_text,1,40) sql_text
from dba_hist_sqlstat a , dba_hist_snapshot b, dba_hist_sqltext c
where a.snap_id=b.snap_id and
a.INSTANCE_NUMBER = b.INSTANCE_NUMBER and 
a.sql_id = c.sql_id and 
trunc(begin_interval_time) >= '&start_date' and
--trunc(begin_interval_time) = trunc(sysdate) and
(a.sql_id,plan_hash_value) in ( select sql_id,plan_hash_value from dba_hist_sql_plan 
where object_name = '&index_name') and 
executions_delta > 0 order by a.sql_id,begin_interval_time;

