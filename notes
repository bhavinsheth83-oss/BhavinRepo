// to know when was the view or any object modified with date and time

select object_name, object_type, created, to_char(last_ddl_time,'dd/mm/yyyy hh24:mi:ss') 
from dba_objects
where object_name = 'BTVWFLAVOURJOURNEYDETAILS';


// to know how many insert, update and deletes on table
select * from dba_tab_modifications where table_name='UM_USERROLE';



// to find dependent constraints
SELECT p.table_name "Parent Table", c.table_name "Child Table",
     p.constraint_name "Parent Constraint", c.constraint_name "Child Constraint"
     FROM dba_constraints p
     JOIN dba_constraints c ON(p.constraint_name=c.r_constraint_name)
     WHERE (p.constraint_type = 'P' OR p.constraint_type = 'U')
     AND c.constraint_type = 'R'
     AND p.table_name = UPPER('MHW_MIS_REPORT_DATA');
	 
	 
// to find dependent Referential constraints( Foreign Key constraints or R type of constraints)
select
   cons.owner            as child_owner,
   cons.table_name       as child_table,
   cons.constraint_name     constaint_name,
   cons.constraint_type     constraint_type,
   col.owner                parent_owner,
   col.table_name           parent_table,
   col.column_name          column_name
from
   dba_cons_columns      col,
   dba_constraints       cons
where
   cons.r_owner = col.owner
and
   cons.r_constraint_name = col.constraint_name
and
   cons.table_name = 'ACT_HI_JOB_LOG' and cons.owner='SUPPLEMENTARY_PROCESS';	


// to disable foreign key constraints, referential constraints
select 'alter table '||a.owner||'.'||a.table_name||' disable constraint '||a.constraint_name||';'
from dba_constraints a,dba_constraints b
where a.constraint_type = 'R' and a.status='ENABLED'
and a.r_constraint_name = b.constraint_name
and a.r_owner  = b.owner
and b.table_name = upper('ACT_GE_BYTEARRAY')and a.owner='SUPPLEMENTARY_PROCESS';    


-- truncate table URL, explaination of truncate command
https://oracle-base.com/articles/12c/truncate-table-cascade-12cr1 


Note: When you want to truncate the parent table, keep in mind you have to disable all the foreign key(referential) constraints 
i.e child table constraints, to find foreign key constraints use below query:

select 'alter table '||a.owner||'.'||a.table_name||' disable constraint '||a.constraint_name||';'
from dba_constraints a,dba_constraints b
where a.constraint_type = 'R' and a.status='ENABLED'
and a.r_constraint_name = b.constraint_name
and a.r_owner  = b.owner
and b.table_name = upper('ACT_GE_BYTEARRAY')and a.owner='SUPPLEMENTARY_PROCESS';   

	 
	 
// to drop all the objects in oracle database of a particular schema ( drop objects)
select ' drop ' || object_type ||' '|| object_name ||';' from dba_objects where owner='MIS_SCHEMA'
and object_type in(
'SEQUENCE',
'PROCEDURE',
'PACKAGE',
'PACKAGE BODY',
'TRIGGER',
'INDEX',
'TABLE',
'FUNCTION',
'VIEW',
'TYPE'
)order by object_type;	 

