// To convert RAW datatype to text format

declare 
a varchar(255); 
b long raw; 
--b varchar(255); 
cursor c1 is select BIND_DATA from dba_sqlset_statements where sql_id='fsmyk3f7kgptw'; 
begin 
open c1; 
loop 
fetch c1 into b ; 
exit when c1%notfound; 
a:=UTL_RAW.CAST_TO_VARCHAR2(b); 
dbms_output.put_line(a); 
end loop; 
end; 


