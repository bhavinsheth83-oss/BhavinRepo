// Bulk update procedure.	
	
	
set timing on
DECLARE
c_limit PLS_INTEGER :=10;
  CURSOR ACT_HI_VARINST_TEMP_CURR
  IS select * from ACT_HI_VARINST where ROOT_PROC_INST_ID_ not in (select ROOT_PROC_INST_ID_ from ACT_HI_PROCINST_BK_JULY1);
TYPE ACT_HI_VARINST_TEMP_ATT
IS
  TABLE OF ACT_HI_VARINST_TEMP_CURR%ROWTYPE INDEX BY PLS_INTEGER;
  L_ACT_HI_VARINST_TEMP  ACT_HI_VARINST_TEMP_ATT;
  start_time number;
  end_time number;
BEGIN
  OPEN ACT_HI_VARINST_TEMP_CURR;
  start_time := DBMS_UTILITY.get_time;
  LOOP
    FETCH ACT_HI_VARINST_TEMP_CURR 
    BULK COLLECT INTO L_ACT_HI_VARINST_TEMP 
    LIMIT c_limit;
    FORALL l_row IN 1 .. L_ACT_HI_VARINST_TEMP.count
    update ACT_HI_VARINST r set r.REMOVAL_TIME_=TO_DATE('01-JUL-22','DD-MON-YY') where r.ID_= L_ACT_HI_VARINST_TEMP(l_row).ID_;
    dbms_output.put_line(L_ACT_HI_VARINST_TEMP.count);
    EXIT WHEN ACT_HI_VARINST_TEMP_CURR%NOTFOUND;
    COMMIT;
  END LOOP;
  COMMIT;
  end_time := DBMS_UTILITY.get_time;
  DBMS_OUTPUT.PUT_LINE('BULK COLLECT UPDATE: '||to_char(end_time-start_time));
  CLOSE ACT_HI_VARINST_TEMP_CURR;
END;
/

