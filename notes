Normal Tables:-
select 'EXECUTE DBMS_STATS.GATHER_TABLE_STATS(ownname=>'||chr(39)||'SIEBEL'||chr(39)||',tabname=>'||chr(39)||table_name||chr(39)||',estimate_percent=> DBMS_STATS.AUTO_SAMPLE_SIZE, degree=> 12 ,cascade=>TRUE, granularity=> '||chr(39)||'ALL'||chr(39)||',method_opt=>'||chr(39)||'FOR ALL INDEXED COLUMNS SIZE 254'||chr(39)||');'
from dba_tables where owner='SIEBEL' 
and table_name not in (select table_name from dba_tab_partitions where table_owner='SIEBEL');

Partition Tables:-

select 'EXECUTE DBMS_STATS.GATHER_TABLE_STATS(ownname=>'||chr(39)||'SIEBEL'||chr(39)||',tabname=>'||chr(39)||table_name||chr(39)||',estimate_percent=> DBMS_STATS.AUTO_SAMPLE_SIZE, degree=> 12 ,cascade=>TRUE, granularity=> '||chr(39)||'GLOBAL AND PARTITION'||chr(39)||',method_opt=>'||chr(39)||'FOR ALL INDEXED COLUMNS SIZE 254'||chr(39)||');'
from dba_tab_partitions where owner='SIEBEL' ;


