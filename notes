// Bulk Insert procedure 


set timing on
DECLARE
 c_limit PLS_INTEGER :=50000;
  CURSOR ACT_HI_DETAIL_TEMP_CURR
  IS
    select * from ACT_HI_DETAIL_FLAT_22APR2022 
	where 
	ROOT_PROC_INST_ID_ in 
	(
	select 
	PROC_INST_ID_ 
	from 
	ACT_HI_PROCINST_FLAT_22APR2022_COND 
	);
TYPE ACT_HI_DETAIL_TEMP_ATT
IS
  TABLE OF ACT_HI_DETAIL_TEMP_CURR%ROWTYPE INDEX BY PLS_INTEGER;
  L_ACT_HI_DETAIL_TEMP  ACT_HI_DETAIL_TEMP_ATT;
  start_time number;
  end_time number;
BEGIN
  --truncate destination table for fresh insert
  -- EXECUTE IMMEDIATE 'truncate table ACT_HI_DETAIL_PART_22APR2022';
  OPEN ACT_HI_DETAIL_TEMP_CURR;
  start_time := DBMS_UTILITY.get_time;
  LOOP
    FETCH ACT_HI_DETAIL_TEMP_CURR 
    BULK COLLECT INTO L_ACT_HI_DETAIL_TEMP 
    LIMIT c_limit;
    
    FORALL l_row IN 1 .. L_ACT_HI_DETAIL_TEMP.count
    INSERT INTO ACT_HI_DETAIL_PART_22APR2022 
      values(
 	  L_ACT_HI_DETAIL_TEMP(l_row).ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).TYPE_,
	  L_ACT_HI_DETAIL_TEMP(l_row).PROC_DEF_KEY_,
	  L_ACT_HI_DETAIL_TEMP(l_row).PROC_DEF_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).ROOT_PROC_INST_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).PROC_INST_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).EXECUTION_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).CASE_DEF_KEY_,
	  L_ACT_HI_DETAIL_TEMP(l_row).CASE_DEF_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).CASE_INST_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).CASE_EXECUTION_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).TASK_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).ACT_INST_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).VAR_INST_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).NAME_,
	  L_ACT_HI_DETAIL_TEMP(l_row).VAR_TYPE_,
	  L_ACT_HI_DETAIL_TEMP(l_row).REV_,
	  L_ACT_HI_DETAIL_TEMP(l_row).TIME_,
	  L_ACT_HI_DETAIL_TEMP(l_row).BYTEARRAY_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).DOUBLE_,
	  L_ACT_HI_DETAIL_TEMP(l_row).LONG_,
	  L_ACT_HI_DETAIL_TEMP(l_row).TEXT_,
	  L_ACT_HI_DETAIL_TEMP(l_row).TEXT2_,
	  L_ACT_HI_DETAIL_TEMP(l_row).SEQUENCE_COUNTER_,
	  L_ACT_HI_DETAIL_TEMP(l_row).TENANT_ID_,
	  L_ACT_HI_DETAIL_TEMP(l_row).OPERATION_ID_,	   
	  DEFAULT,
	  L_ACT_HI_DETAIL_TEMP(l_row).INITIAL_	 
	 );
    dbms_output.put_line(L_ACT_HI_DETAIL_TEMP.count);
    EXIT WHEN ACT_HI_DETAIL_TEMP_CURR%NOTFOUND;
    COMMIT;
  END LOOP;
  COMMIT;
  end_time := DBMS_UTILITY.get_time;
  DBMS_OUTPUT.PUT_LINE('BULK COLLECT INSERT: '||to_char(end_time-start_time));
  CLOSE ACT_HI_DETAIL_TEMP_CURR;
END;
