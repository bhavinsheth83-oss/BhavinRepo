// to grant proxy privileges, create proxy user	, create user and kill own session privileges				  
					  
exec c##service_manager.bt_user_management.create_user(p_username => 'PATELT', p_password => 'c0untach1',  p_default_tablespace => 'PROCESS_DATA', p_profile => 'BT_DEFAULT', p_role => 'BT_USER', p_change_reference => 'C100337486');
exec c##service_manager.bt_user_management.kill_own_session(p_username => 'PATELT', p_case_reference => 'C100337486');
exec c##service_manager.bt_user_management.create_proxy_user('SRIMSRO','PATELT','C100337486'); 

alter user SRIMSRO grant connect through ASRAM2;				


implementation notes for PDBDBA and killing session for 3 L DBA
alter user PDBDBA grant connect through SHETHB;

