CREATE USER MIG_USER
IDENTIFIED BY <Password>
DEFAULT TABLESPACE USERS
TEMPORARY TABLESPACE TEMP;

GRANT FLASHBACK ANY TABLE TO MIG_USER;
GRANT ALTER SESSION TO MIG_USER;
GRANT EXECUTE ON SYS.DBMS_SESSION TO MIG_USER;
GRANT EXECUTE ON SYS.UTL_FILE TO MIG_USER;
GRANT EXECUTE ON SYS.DBMS_FLASHBACK TO MIG_USER;
