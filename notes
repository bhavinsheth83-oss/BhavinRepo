SELECT DBMS_METADATA.get_ddl ('CONSTRAINT', constraint_name, owner)
FROM   user_constraints
WHERE  table_name='DEVICE'
AND    constraint_type IN ('U', 'P');


// To get DDL of sequences
select  DBMS_METADATA.get_ddl ('SEQUENCE', sequence_name, user) || ';' FROM   user_sequences;

// To get DDL of indexes
select  DBMS_METADATA.get_ddl ('INDEX', index_name, user) || ';' FROM   user_indexes where table_owner='SRIMS';

