// query to store index size
update index_size i set index_size =(select sum(bytes)/1024/1024 from dba_segments 
where owner =i.owner and segment_name=i.index_name)


update index_size i set num_rows =(select num_rows from dba_tables 
where owner =i.owner and segment_name=i.index_name)


