// Query  for index rebuild for non partitioned tables

select ' alter index ' || index_name || ' rebuild online ' || ';' from dba_indexes where table_owner='SRIMS' and partitioned='NO'
and table_name in 
(
'INCLUSION_TABLE',
'SERVICEORDERHISTORY'
);


// to rebuild global indexes
select ' alter index ' || index_name || ' rebuild online parallel 8' || ';' from user_indexes where partitioned='NO' and uniqueness='UNIQUE'
and table_name in 
(
'ACT_GE_BYTEARRAY', 
'ACT_HI_DETAIL', 
'ACT_HI_VARINST', 
'ACT_HI_ACTINST', 
'ACT_HI_JOB_LOG',
'ACT_HI_DECINST',
'ACT_HI_DEC_IN',
'ACT_HI_DEC_OUT'
);


