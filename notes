// To find the SQLs executed in specified time by snap id

SELECT TO_CHAR(sn.begin_interval_time,'DD:MON:YY HH24:MI:SS') timestamp,
  sql.INSTANCE_NUMBER,
  sql.PARSING_SCHEMA_NAME,
  sql.sql_id,
  sql.plan_hash_value,
  SUM(sql.EXECUTIONS_DELTA) execs,
  SUM(sql.DISK_READS_DELTA) disk,
  SUM(sql.BUFFER_GETS_DELTA) lio,
  SUM(sql.ROWS_PROCESSED_DELTA) rws,
  SUM(sql.CPU_TIME_DELTA    /1000000) cpu,
  SUM(sql.ELAPSED_TIME_DELTA/1000000) elapse
FROM dba_hist_sqlstat SQL,
  dba_hist_snapshot sn
WHERE sql.dbid =sn.dbid
AND sql.snap_id=sn.snap_id
AND sn.snap_id BETWEEN 266272 AND 266274
AND sql.sql_id = '0jtquvhma44sd'
GROUP BY TO_CHAR(sn.begin_interval_time,'DD:MON:YY HH24:MI:SS'),
  sql.PARSING_SCHEMA_NAME,
  sql.sql_id,
  sql.plan_hash_value,
  sql.INSTANCE_NUMBER
ORDER BY elapse DESC;

