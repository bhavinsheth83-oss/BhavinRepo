PROMPT Review amount of archive REDO log and size to accommodate 4 days (3 days plus 1 days contingency)
select  RedoCount,round(Redo_Size_GB+0.5),sysdate - 30 From_Date, sysdate To_Date
from (
SELECT COUNT (*) RedoCount,TRUNC(first_time) "Date",
ROUND(SUM(blocks*block_size)/1024/1024/1024,2) Redo_Size_GB
from v$archived_log
where (TRUNC(first_time) > sysdate - 30)
AND standby_dest = 'NO'
GROUP BY TRUNC(first_time)
order by 3 desc)
where rownum<=1;

select count  (*) "Redo Count",
trunc(first_time) "Date",
round(sum(blocks*block_size)/1024/1024/1024,2) "Amount of Redo in Gb"
from ( select distinct name, blocks, block_size, first_time from gv$archived_log )
where trunc(first_time) > sysdate - 30
group by trunc(first_time)
order by 2 desc;


