// To rebuild partition index

SELECT 'alter index '||index_owner||'.'||index_name ||' rebuild partition '||PARTITION_NAME||' TABLESPACE '||tablespace_name ||';' sql_to_rebuild_index
FROM   dba_ind_partitions
WHERE  status = 'UNUSABLE'; 


// to rebuild normal index

select 'alter index '||index_name||' rebuild online;' from user_indexes where table_name = 'PHYSICALLINK';


