// To get outline data, plans and to flush buffer cache

SELECT * FROM TABLE(DBMS_XPLAN.display_cursor(sql_id=>'bdd65u5wrqrw4',
                                      format=>'ALLSTATS LAST +cost +bytes'));  


 
select count(1) from (select * from tab order by rowid);
 
  
select
   o.owner          owner,
   o.object_name    object_name,
   o.subobject_name subobject_name,
   o.object_type    object_type,
   count(distinct file# || block#)         num_blocks
from
   dba_objects  o,
   v$bh         bh
where
   o.data_object_id  = bh.objd
and
   o.owner not in ('SYS','SYSTEM')
and
   bh.status != 'free'
group by
   o.owner,
   o.object_name,
   o.subobject_name,
   o.object_type
order by
   count(distinct file# || block#) desc 
 
select * from table(dbms_xplan.display('PLAN_TABLE',NULL, 'OUTLINE')); 


