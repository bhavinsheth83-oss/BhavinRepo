// Index monitoring( to check which index is used )
declare
begin
for cur in (select index_name from user_indexes where index_type NOT IN('IOT - TOP','LOB','DOMAIN'))
loop
    begin
        execute immediate 'alter index '||cur.index_name||' monitoring usage';
    end;
end loop;
end;
