example:
select dbms_stats.get_prefs('STALE_PERCENT','MAIL','TBLMESSAGES') stale_percent from dual;


select max(LAST_ANALYZED) from dba_tab_statistics where owner='SIEBEL' and table_name='S_ACT_EMP';

select TABLE_NAME,NUM_ROWS,SAMPLE_SIZE,(SAMPLE_SIZE*100/NUM_ROWS) PCT,LAST_ANALYZED 
from dba_tab_statistics where OWNER='SIEBEL' and table_name like 'S%'and NUM_ROWS > 1000000
 
 
select TABLE_NAME,NUM_ROWS,SAMPLE_SIZE,(SAMPLE_SIZE*100/NUM_ROWS) PCT,LAST_ANALYZED ,
case when NUM_ROWS between 0 AND 1000000 then '100'
when NUM_ROWS between 1000000 and 10000000 then '30'
when NUM_ROWS between 10000000 and 100000000 then '10'
when NUM_ROWS between 100000000 and 1000000000 then '3'
when NUM_ROWS > 1000000000 then '1' end as "Ideal PCT"
from dba_tab_statistics where OWNER='SIEBEL'
order by NUM_ROWS desc
and NUM_ROWS > 1000000 and table_name like 'S_%'; 



// when u get error as "ORA-01476 divisor is equal to zero
select TABLE_NAME,NUM_ROWS,SAMPLE_SIZE,case when num_rows = 0 then null else (SAMPLE_SIZE*100/NUM_ROWS) end PCT,LAST_ANALYZED ,
case when NUM_ROWS between 0 AND 1000000 then '100'
when NUM_ROWS between 1000000 and 10000000 then '30'
when NUM_ROWS between 10000000 and 100000000 then '10'
when NUM_ROWS between 100000000 and 1000000000 then '3'
when NUM_ROWS > 1000000000 then '1' end as "Ideal PCT"
from dba_tab_statistics where OWNER='SIEBEL'
order by num_rows desc



// To know the table names for which the stats has to be gathered( like S_ , CX_ )
SELECT t.owner, s.table_name,t.table_name, s.sample_size,t.temporary, t.partitioned, t.num_rows,s.num_rows, t.last_analyzed,s.LAST_ANALYZED, s.stattype_locked, s.stale_stats,
case when s.NUM_ROWS between 0 AND 1000000 then '100'
when s.NUM_ROWS between 1000000 and 10000000 then '30'
when s.NUM_ROWS between 10000000 and 100000000 then '10'
when s.NUM_ROWS between 100000000 and 1000000000 then '3'
when s.NUM_ROWS > 1000000000 then '1' end as "Ideal PCT"
                FROM sys.dba_tables t,
                     sys.dba_tab_statistics s
               WHERE t.owner = 'SIEBEL'
                 AND (t.table_name LIKE 'S^_%' ESCAPE '^' -- "S_%"
                  OR  t.table_name LIKE 'CX^_%' ESCAPE '^') -- "CX_%"
                 AND t.table_name NOT LIKE 'S^_ETL%' ESCAPE '^' -- "S_ETL%"
                 AND t.table_name NOT LIKE 'BIN$%' -- recycle bin
                 AND t.table_name NOT LIKE 'DR$%' -- bug 8452962
                 AND t.table_name NOT LIKE 'DR#%' -- bug 8452962
                 AND (t.iot_type IS NULL OR t.iot_type <> 'IOT_OVERFLOW')
                 AND t.owner = s.owner
                 AND t.table_name = s.table_name
                 AND s.object_type = 'TABLE';



// To check whether the stats are locked, if the value of stattype_locked='ALL' then it is locked
select owner, table_name, stattype_locked from dba_tab_statistics where owner='SIEBEL' and stattype_locked is not null; 


