// To check Difference in data volume between two databases

set heading on
set line 200;
set pagesize 200;
col Allo_G for 99999999.99;
col Free_G for 99999999.99;
col Used_G for 99999999.99;
col Free_Percent for 99999999.99;
col MAx_G for 99999999.99;
col Max_free_G for 99999999.99;
select a.TABLESPACE_NAME, a.allo Allo_G, a.allo - b.free Used_G, b.free Free_G, 100*b.free/a.allo Free_Percent,
a.max Max_G, (a.max-a.allo + b.free) Max_free_G
from
(select TABLESPACE_NAME, sum(bytes)/1024/1024/1024 allo, sum(decode(maxbytes,null,bytes,0,bytes,maxbytes))/1024/1024/1024 max from dba_data_files group by TABLESPACE_NAME) a,
(select TABLESPACE_NAME, sum(bytes)/1024/1024/1024 free from dba_free_space group by TABLESPACE_NAME) b
where a.TABLESPACE_NAME = b.TABLESPACE_NAME
order by 100*b.free/a.allo

