    name                                     group_name
  , total_mb                                 total_mb,
  free_mb                                   FREE_MB
  , (total_mb - free_mb)                     used_mb
  , ROUND((1- (free_mb / total_mb))*100, 2)  pct_used,
  free_mb/total_mb*100 as "PERCENTAGE FREE"
FROM
    v$asm_diskgroup;
	
	
