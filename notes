// To generate DDL for indexes, sequences


select  DBMS_METADATA.get_ddl ('INDEX', index_name, user) || ';' FROM   user_indexes;


// To alter all sequence cache 
select ' alter sequence ' || sequence_name || ' cache 5000' || ';' from user_sequences;

// to get DDL for users
select dbms_metadata.get_ddl('USER','SYSTEM') from dual;


SELECT DBMS_METADATA.GET_GRANTED_DDL('ROLE_GRANT','SCOTT') from dual;



SELECT DBMS_METADATA.GET_GRANTED_DDL('OBJECT_GRANT','SCOTT') from dual;



SELECT DBMS_METADATA.GET_GRANTED_DDL('SYSTEM_GRANT','SCOTT') from dual;



SELECT dbms_metadata.get_ddl('ROLE','RESOURCE') from dual;



SELECT DBMS_METADATA.GET_GRANTED_DDL('SYSTEM_GRANT','RESOURCE') from dual;




// To get ddl for any type of object(table,package,package body, indexes, procedure, function, synonyms)
sytax:

select  DBMS_METADATA.get_ddl ('<object_type>', '<object_name>', '<owner or user>')  from dual; 

-- example of procedure
select  DBMS_METADATA.get_ddl ('PROCEDURE', 'PRC_FTTP_MISSING_DEV_2', 'SRIMS')  from dual; 

-- example of table
select  DBMS_METADATA.get_ddl ('TABLE', 'UIINVQC_2409_1546', 'SRIMS_PHX')  from dual; 

-- example of package 
select  DBMS_METADATA.get_ddl ('PACKAGE', 'TEST_PKGDIMENSIONCONSTANTS', 'SRIMS')  from dual; 

-- example of package body
select  DBMS_METADATA.get_ddl ('PACKAGE_BODY', 'PKG_FUNCTIONAL_COVERAGE', 'SRIMS')  from dual; 

-- example of function
select  DBMS_METADATA.get_ddl ('FUNCTION', 'FN_GETMFNOWNINGDEV', 'SRIMS')  from dual;

-- example (to get DDL of job name)
select dbms_metadata.get_ddl('PROCOBJ','<JOB_NAME>','<OWNER>') from dual;

-- DDL for sequences
select  DBMS_METADATA.get_ddl ('SEQUENCE', SEQUENCE_NAME, sequence_owner) || ';' from dba_sequences; 


// to give role grants to user
spool role_grants.sql
select 'grant '||GRANTED_ROLE||' to '||GRANTEE||';' from dba_role_privs where GRANTEE in ('<>');
spool off

 
// to give table grants to user
spool table_grants.sql
select 'Grant '
|| PRIVILEGE
|| ' ON '
|| OWNER
|| '.'||TABLE_NAME
|| ' to '
|| 'GRANTEE'
|| ';'
From dba_tab_privs where grantee in ('<>');
spool off

 
// to give system privileges to user
spool sysprivs.sql
SELECT 'GRANT '||PRIVILEGE||' TO '||'LAWSONS6'||';' FROM DBA_SYS_PRIVS WHERE ADMIN_OPTION='NO' and GRANTEE IN ('<>');
spool off;


