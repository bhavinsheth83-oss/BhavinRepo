// To drop job of a scheduler

Syntax:
------
DBMS_SCHEDULER.DROP_JOB (
   job_name                IN VARCHAR2,
   force                   IN BOOLEAN DEFAULT FALSE,
   defer                   IN BOOLEAN DEFAULT FALSE,
   commit_semantics        IN VARCHAR2 DEFAULT 'STOP_ON_FIRST_ERROR');
   

example:
-------- 
exec DBMS_SCHEDULER.DROP_JOB (job_name => 'CCC_REFIP15_2N_6974');


// to drop multiple jobs
select 'exec DBMS_SCHEDULER.DROP_JOB('''||Job_Name||''');' from dba_scheduler_jobs where owner='MIS_SCHEMA';


// to check the job refresh status
select * from user_scheduler_job_run_details where job_name like 'MVIEW_PMMIS%' and log_date>='28-JAN-21 12.11.02.509704000 GMT' order by log_date desc;

select * from user_scheduler_jobs where job_name='MVIEW_PMMIS_FSI_MESSAGE';


select * from dba_scheduler_job_run_details where owner='WMIG_DB' and status='FAILED' order by log_date desc;

select * from dba_scheduler_job_run_details where owner='WMIG_DB' and job_name like 'MVIEW_EXCHRANGE_MAPPING_1%' order by log_date desc;

select * from dba_scheduler_job_run_details where owner='WMIG_DB' order by log_date desc;

// to check mview refresh status
SELECT owner, mview_name, last_refresh_date FROM dba_mviews WHERE owner = 'WMIG_DB2' and mview_name='PMMIS_FSI_MESSAGE';

// to check mview(materialized view) refresh status
alter session set nls_date_format='dd/mm/yy hh24:mi:ss';

select owner, mview_name, last_refresh_type, last_refresh_date
    from all_mviews;
	
// to check jobs status.	
select job_name,job_action,state from user_scheduler_jobs where job_name='MVIEW_PMMIS_FSI_MESSAGE';	


// to check which jobs are running
select owner,job_name,enabled,state from dba_scheduler_jobs where state='RUNNING';

################################################################################################################################################################
// DIA-48447 error solution


DIA-48447: The input path does not contain any ADR homes
 Oracle Database Tips by Donald BurlesonMay 20, 2016 


Question: What do I do to resolve the DIA-48447 error?

adrci> set homepath /opt/oracle/admin/PDS_OR3/diag/rdbms/ulfp/PDS_OR3

DIA-48447: The input path [/opt/oracle/admin/PDS_OR3/diag/rdbms/ulfp/PDS_OR3] does not contain any ADR homes

Answer:  The oerr utility shows this for the DIA-48447 error:

DIA-48447: The input path [string] does not contain any ADR homes

 Cause: The input path does not contain ADR homes

Action: Validate the path

In this case you need to issue the adrci "set base" command:

adrci> set base /u01/app/oracle 

