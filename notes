// To find table size
select OWNER,SEGMENT_NAME,SEGMENT_TYPE,TABLESPACE_NAME,sum(BYTES)/1024/1024 MB,  sum(BYTES)/1024/1024/1024 GB from dba_segments where 
SEGMENT_TYPE='TABLE' and SEGMENT_NAME='X$KTFBUE' and owner='SYS' group by OWNER,SEGMENT_NAME,SEGMENT_TYPE,TABLESPACE_NAME; 



// table size with schema name
select owner || '-' || sum(bytes)/1024/1024 "MB" from dba_segments where segment_name in
('ACT_HI_ACTINST',
'ACT_HI_VARINST',
'ACT_RU_VARIABLE',
'ACT_RU_METER_LOG'
) and segment_type='TABLE' and owner='JEOPARDY_MANAGEMENT'
group by owner;




// To find table size in MB and GB
select OWNER,SEGMENT_NAME,SEGMENT_TYPE,TABLESPACE_NAME,sum(BYTES)/1024/1024 MB, sum(BYTES)/1024/1024/1024 GB from dba_segments where 
SEGMENT_TYPE='TABLE' and owner='SIEBEL' and segment_name='S_ASSET_XM' group by OWNER,SEGMENT_NAME,SEGMENT_TYPE,TABLESPACE_NAME
order by GB desc;

// DB size
The size of the database is the space the files physically consume on disk.
select sum(bytes)/1024/1024 size_in_mb, sum(bytes)/1024/1024/1024 "GB" from dba_data_files;


// to find tables with LOB columns
select col.owner as schema_name,
       col.table_name, 
       count(*) as column_count
from sys.dba_tab_columns col
inner join sys.dba_tables t on col.owner = t.owner 
                              and col.table_name = t.table_name
where col.data_type in ('BLOB', 'CLOB', 'NCLOB', 'BFILE')
-- excluding some Oracle maintained schemas
and col.owner  in ('MIS_SCHEMA')  
group by col.owner,
         col.table_name
order by col.owner, 
         col.table_name;


// to check db size with index not included
Select owner,sum(bytes/(1024*1024*1024)) size_gb
from dba_segments
where owner='MIS_SCHEMA'
and segment_type not in ('INDEX')
group by owner;


// to know temp tablespace usage users
SELECT S.sid || ',' || S.serial# sid_serial, S.username, S.osuser, P.spid, S.module,
P.program, SUM (T.blocks) * TBS.block_size / 1024 / 1024 mb_used, T.tablespace,
COUNT(*) statements
FROM v$sort_usage T, v$session S, dba_tablespaces TBS, v$process P
WHERE T.session_addr = S.saddr
AND S.paddr = P.addr
AND T.tablespace = TBS.tablespace_name
GROUP BY S.sid, S.serial#, S.username, S.osuser, P.spid, S.module,
P.program, TBS.block_size, T.tablespace
ORDER BY sid_serial; 

// temp tablespace usage
select a.tablespace_name tablespace,
d.TEMP_TOTAL_MB,
sum (a.used_blocks * d.block_size) / 1024 / 1024 TEMP_USED_MB,
d.TEMP_TOTAL_MB - sum (a.used_blocks * d.block_size) / 1024 / 1024 TEMP_FREE_MB
from gv$sort_segment a,
(
select b.name, c.block_size, sum (c.bytes) / 1024 / 1024 TEMP_TOTAL_MB
from gv$tablespace b, gv$tempfile c
where b.ts#= c.ts#
group by b.name, c.block_size
) d
where a.tablespace_name = d.name
group by a.tablespace_name, d.TEMP_TOTAL_MB;

// temp tablespace 
SELECT s.sid
  || ','
  || s.serial# sid_serial,
  s.username,
  o.blocks * t.block_size / 1024 / 1024 mb_used,
  o.tablespace,
  o.sqladdr address,
  h.hash_value,
  h.sql_text
FROM gv$sort_usage o,
  gv$session s,
  gv$sqlarea h,
  dba_tablespaces t
WHERE o.session_addr = s.saddr
AND o.sqladdr        = h.address (+)
AND o.tablespace     = t.tablespace_name
ORDER BY s.sid;


// to find tables without primary key(No primary key on table)
select t.owner as schema_name,
       t.table_name,c.constraint_type
from sys.dba_tables t
left join sys.dba_constraints c
          on t.owner = c.owner
          and t.table_name = c.table_name
          and c.constraint_type = 'P'
where c.constraint_type is null and t.owner in('BB_INTERFACE','SIWORKFLOW','SIRESOURCE','MAIL')
order by t.owner,
         t.table_name,c.constraint_type;
		 
