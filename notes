// Get trial execution details (OSPUG)

SQL> select TASK_NAME,EXECUTION_NAME,EXECUTION_TYPE,PLAN_HASH_VALUE,ELAPSED_TIME,BUFFER_GETS,FETCHES,ROWS_PROCESSED,EXECUTIONS 
from dba_advisor_sqlstats where sql_id='&sql_id';


// Get live execution details (OSPUG)
col action for a20
col module for a30
select PLAN_HASH_VALUE,MODULE,ACTION,ELAPSED_TIME,BUFFER_GETS,FETCHES,ROWS_PROCESSED,EXECUTIONS 
from dba_sqlset_statements where sql_id='&sql_id';


// To find various details of SQL_ID for SPA(plan hash value, buffer gets) Pre trial and Post trial( Run on OSUPG)
select TASK_NAME,EXECUTION_NAME,EXECUTION_TYPE,PLAN_HASH_VALUE,ELAPSED_TIME,BUFFER_GETS,ROWS_PROCESSED,EXECUTIONS from 
dba_advisor_sqlstats where sql_id = '&sqlid' and TASK_NAME like '%TASK%' order by TASK_NAME


