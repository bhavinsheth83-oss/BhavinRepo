// To check the tuning set created

desc dba_sqlset

// To create tuning set

exec dbms_sqltune.create_sqlset('<sqlset_name>');

// To drop tuning set

exec dbms_sqltune.drop_sqlset('<sqlset_name>');

// To find the SQL IDs

SELECT distinct(SQL_ID)
FROM   TABLE( DBMS_SQLTUNE.SELECT_SQLSET( '<sqlset_name>' ))

// to get outline data use below 
select * FROM table(dbms_xplan.display_awr('&sqlid')); 
 
