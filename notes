SELECT 
    tablespace_name, 
    extent_management, 
    segment_space_management,
    CASE WHEN segment_space_management ='AUTO' THEN 'IS ASSM' ELSE 'NOT ASSM' 
    END 
    AS ASSM
FROM user_tablespaces 
    WHERE tablespace_name not IN ('TEMP','SYSAUX','SYSTEM','UNDO');
	
	
-- To check the current size of the Undo tablespace

select sum(a.bytes) as undo_size from v$datafile a, v$tablespace b, dba_tablespaces c where 
c.contents = 'UNDO' and c.status = 'ONLINE' and b.name = c.tablespace_name and a.ts# = b.ts#;

-- to check usage of undo tablespace
select count(segment_name),sum(bytes/1024/1024),status from dba_undo_extents group by status;


-- To check the free space (unallocated) space within Undo tablespace

select sum(bytes)/1024/1024 "mb" from dba_free_space where tablespace_name ='[undo tablespace name]';

-- to check undo tablespace 
SELECT a.tablespace_name,
SIZEMB,
USAGEMB,
(SIZEMB - USAGEMB) FREEMB
FROM ( SELECT SUM (bytes) / 1024 / 1024 SIZEMB, b.tablespace_name
FROM dba_data_files a, dba_tablespaces b
WHERE a.tablespace_name = b.tablespace_name AND b.contents like 'UNDO'
GROUP BY b.tablespace_name) a,
( SELECT c.tablespace_name, SUM (bytes) / 1024 / 1024 USAGEMB
FROM DBA_UNDO_EXTENTS c
--WHERE status <> 'EXPIRED'
GROUP BY c.tablespace_name) b
WHERE a.tablespace_name = b.tablespace_name;

-- to check undo tablespace , free space, percent wise free
select
  a.tablespace_name,
  sum(a.bytes)/(1024*1024) total_space_MB,
  round(b.free,2) Free_space_MB,
  round(b.free/(sum(a.bytes)/(1024*1024))* 100,2) percent_free
 from dba_data_files a,
  (select tablespace_name,sum(bytes)/(1024*1024) free  from dba_free_space
  group by tablespace_name) b
 where a.tablespace_name = b.tablespace_name(+)
 and a.tablespace_name like 'UNDO%'
  group by a.tablespace_name,b.free;


-- To Check the space available within the allocated Undo tablespace

select tablespace_name, sum(blocks)*8/(1024) reusable_space from dba_undo_extents where status='EXPIRED' group by tablespace_name;

-- To Check the space allocated in the Undo tablespace

select tablespace_name , sum(blocks)*8/(1024) space_in_use from dba_undo_extents where status IN ('ACTIVE','UNEXPIRED') group by  tablespace_name;


