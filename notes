SELECT 
    fruit_name,
    color,
    COUNT(*)
FROM 
    fruits
GROUP BY 
    fruit_name,
    color;
	
	
	select serial_id, count(*) from MHW_ARTISAN_A1024 group by serial_id having count(*)>1;
	
	
// to remove duplicate records	
	DELETE
FROM
  fruits
WHERE
  rowid NOT IN
  (
    SELECT
      MIN(rowid)
    FROM
      fruits
    GROUP BY
      fruit_id,
      fruit_name,
      color
  );


 
