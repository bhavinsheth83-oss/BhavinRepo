// script / command to kill sessions active / inactive sessions
select 'alter system kill session '''||SID||','||SERIAL#||','||'@'||INST_ID||''' immediate;'  from gv$session where status = 'INACTIVE' and username != 'SYS' 


// To kill multiple session based on users
SELECT 'ALTER SYSTEM KILL SESSION '''||sid||','||serial#||''' IMMEDIATE;' 
FROM v$session 
where username='<user_name>';

// To check the sid and serial hash to kill session based on username
select sid,serial#, status from gv$session where username='DEPLOYADMIN';
