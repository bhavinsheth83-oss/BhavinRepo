// Generate Sequence Numbers in SQL Select Query( print sequence number, sequential number in sql query output)

SELECT ROW_NUMBER() OVER(ORDER BY name)as S#,
name                                     group_name
, total_mb                                 total_mb,
free_mb                                   FREE_MB
, (total_mb - free_mb)                     used_mb
, ROUND((1- (free_mb / total_mb))*100, 2)  pct_used,
round(free_mb/total_mb*100,2) as "PERCENTAGE FREE"
FROM 
v$asm_diskgroup;


