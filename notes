1st wed ######### SERVICE_ACTIVATION #########
15 3 1-7 2,4,6,8,10,12 * [ "$(date '+\%u')" = "3" ] && sh /archive/partition_scripts/O13_O15_SERVICE_ACTIVATION/O13_O15_servact.sh >> /archive/partition_scripts/O13_O15_SERVICE_ACTIVATION/logs/O13_O15_servact.log



