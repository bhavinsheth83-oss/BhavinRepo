//The first step in the process is to identify the session to be killed. Running jobs that were scheduled using the  
dbms_job  package can be identified using the dba_jobs_running view


set feedback off
alter session set nls_date_format='DD-MON-YYYY HH24:MI:SS';
set feedback on
select
jr.job,
s.username,
s.sid,
s.serial#,
p.spid,
s.lockwait,
s.logon_time from   
dba_jobs_running jr,
v$session s,
v$process p
where
jr.sid = s.sid and
s.paddr = p.addr
order by
jr.job;

