// To know index size with index name
SELECT idx.index_name, SUM(bytes)/1024/1024 MB, SUM(bytes)/1024/1024/1024 GB
  FROM dba_segments seg,
       dba_indexes  idx
 WHERE idx.table_owner = 'SIEBEL'
   AND idx.table_name  = 'CX_PRICEMSIL_BT'
   AND idx.owner       = seg.owner
   AND idx.index_name  = seg.segment_name
 GROUP BY idx.index_name
 
// To know index size 
