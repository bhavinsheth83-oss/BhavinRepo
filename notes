// while creating users on any db, do following

CREATE USER OR_ODS
  IDENTIFIED BY Master@99
  DEFAULT TABLESPACE PROCESS_DATA
  TEMPORARY TABLESPACE TEMP
  PROFILE SCHEMA_PROF
  ACCOUNT UNLOCK;

  GRANT BT_RESOURCE TO OR_ODS;
  ALTER USER OR_ODS DEFAULT ROLE ALL;
  GRANT CREATE ANY TRIGGER to ICM;
  ALTER USER OR_ODS QUOTA UNLIMITED ON PROCESS_DATA; 
 


