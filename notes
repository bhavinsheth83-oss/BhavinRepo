// To kill oracle sessions

SQL> ALTER SYSTEM KILL SESSION 'sid,serial#' IMMEDIATE; 

OR

SQL> ALTER SYSTEM KILL SESSION '967,41867,@1'; 


Ex: ALTER SYSTEM KILL SESSION '1572,1425' IMMEDIATE; 


// Privileges required to kill session
grant alter system to username;



grant execute on sys.p_kill_process to TMS


exec sys.p_kill_process(1385,41934);

// script / command to kill sessions active / inactive sessions
select 'alter system kill session '''||SID||','||SERIAL#||','||'@'||INST_ID||''' immediate;'  from gv$session where status = 'ACTIVE' and username != 'SYS' 


// To kill multiple session based on users
SELECT 'ALTER SYSTEM KILL SESSION '''||sid||','||serial#||''' IMMEDIATE;' 
FROM v$session 
where username='<user_name>';

// To check the sid and serial hash to kill session based on username
select sid,serial#, status from gv$session where username='DEPLOYADMIN';


-- to kill inactive session greater than 30 mins and based on module
select 'exec sys.p_kill_process('||sid||','||serial#||','||module||');' from gv$session where status <> 'ACTIVE' and (last_call_et / 60) > 5
and module='<module_name>';

-- to grant select privs to user for all the tables
select ' grant select on ' || table_name ||' to AIB_RO; '  from user_tables;


-- cursors count for particular schema
SELECT   A.VALUE,
    S.USERNAME,
    S.SID,
    S.SERIAL#
  FROM gV$SESSTAT A,
    gV$STATNAME B,
    gV$SESSION S
  WHERE A.STATISTIC# = B.STATISTIC#
    AND S.SID        = A.SID
    AND B.NAME       = 'opened cursors current'
    AND USERNAME     = 'FALLOUT_MANAGEMENT';
