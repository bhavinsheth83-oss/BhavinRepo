// to drop constraints from multiple tables
select ' alter table ' || table_name || ' drop constraint '|| constraint_name || ' cascade;' from user_constraints where table_name in
('CSPNAMEMETADATA');


// to disable constraints
select 'alter table '||table_name||' disable constraint '||CONSTRAINT_NAME||';'
from user_constraints
where CONSTRAINT_TYPE in('P','R') and status = 'ENABLED';

// to enable constraints
select 'alter table '||table_name||' enable constraint '||CONSTRAINT_NAME||';'
from user_constraints
where CONSTRAINT_TYPE in('P','R') and status = 'DISABLED';

// to find parent table / child table 
select * from all_constraints
where constraint_name in (select r_constraint_name from all_constraints
where table_name ='TBL_ALERTSQLATTRIBUTE'); 


// To drop constraint and recreate(or add) the constraint to table
alter table ACT_RU_VARIABLE drop constraint ACT_FK_VAR_BYTEARRAY;


alter table ACT_RU_VARIABLE
add CONSTRAINT "ACT_FK_VAR_BYTEARRAY" FOREIGN KEY ("BYTEARRAY_ID_")
REFERENCES "ORDER_FTTP_CEASE"."ACT_GE_BYTEARRAY" ("ID_") ENABLE

