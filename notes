// To find jobs in scheduler
select owner,job_name,enabled from dba_scheduler_jobs where owner='SRIMS';


// To enable jobs
exec dbms_scheduler.enable('DAILY_TRANSACTION');


// To disable jobs
exec dbms_scheduler.disable('JOB_SYNC_MONTE_OP_NONPAR');

exec DBMS_SCHEDULER.STOP_JOB (job_name => 'JOB_SYNC_MONTE',force => true);



 select
   rj.job_name,
   s.username,
   s.sid,
   s.serial#,
   p.spid,
   s.lockwait,
   s.logon_time
from 
   dba_scheduler_running_jobs rj,
   v$session s,
   v$process p
where
   rj.session_id = s.sid
and
   s.paddr = p.addr
order by
   rj.job_name;


