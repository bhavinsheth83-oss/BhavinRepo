// To check Data/object corruption or fragmentation in database with issue

Spool frag_db_XX.txt

select t.owner owner,t.table_name table_name,t.tablespace_name tablespace,
t.last_analyzed last_analyzed,round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) USED_MB,
round((st.bytes)/1024/1024) ALLOC_MB,
round((st.bytes)/1024/1024 - (t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024 ) frg_mb,
(((1 - ROUND (( ((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) / round((st.bytes)/1024/1024)), 2)) * 100)) frg_pct
FROM dba_tables t,dba_segments st
WHERE t.owner like '%' and t.partitioned='NO'
and T.OWNER=ST.OWNER and T.TABLE_NAME=ST.SEGMENT_NAME
and t.owner not in ('PUBLIC','WMSYS','CTXSYS','DBSNMP','MDDATA','MDSYS','OLAPSYS','ORDPLUGINS','ORDSYS','OUTLN','SI_INFORMTN_SCHEMA','SYS','SYSMAN','SYSTEM','DMSYS','XDB','KPMS','HR','OE','OC','PM','IX','SH','CSMIG','PERFSTAT','EXFSYS','TSMSYS','DBASPOT2','ASGDBASPOT2','DBASPOT1','ASGDBASPOT1','DERBYDBA','OWBSYS','APPQOSSYS','FLOWS_FILES','FLOWS_030000','DDL_AUDITING','WKSYS','WK_TEST','FLOWS_030000','DDL_AUDITING','WKSYS','WK_TEST','DVSYS','LBACSYS','ORDDATA','OJVMSYS','GSMADMIN_INTERNAL','AUDSYS','SQLTXPLAIN') and t.owner not like 'APEX%'
and round((st.bytes)/1024/1024) > 10
AND (round((st.bytes)/1024/1024 - (t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024 ) > 50
AND (((1 - ROUND ((round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) / round((st.bytes)/1024/1024)), 2)) * 100)) > 30 )
AND round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) > 200
ORDER BY frg_pct desc;

Spool off




// query to check fragmentation table for partition tables
select p.table_owner owner,p.table_name table_name,p.partition_name partition_name,p.tablespace_name tablespace,
p.last_analyzed last_analyzed,round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) USED_MB,
(sp.bytes)/1024/1024 ALLOC_MB,
round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) frg_mb,
(((1 - ROUND (( ((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) frg_pct
FROM  dba_tab_partitions p,dba_segments sp
  where P.TABLE_NAME=SP.SEGMENT_NAME and P.PARTITION_NAME=SP.PARTITION_NAME and P.TABLE_OWNER=SP.OWNER
  and p.table_owner not in ('PUBLIC','WMSYS','CTXSYS','DBSNMP','MDDATA','MDSYS','OLAPSYS','ORDPLUGINS','ORDSYS','OUTLN','SI_INFORMTN_SCHEMA','SYS','SYSMAN','SYSTEM','DM
SYS','XDB','KPMS','HR','OE','OC','PM','IX','SH','CSMIG','PERFSTAT','EXFSYS','TSMSYS','DBASPOT2','ASGDBASPOT2','DBASPOT1','ASGDBASPOT1','DERBYDBA','OWBSYS','APPQOSSYS','FLOWS_FILES') and p.table_owner not like 'APEX%'
  and p.table_owner like '%'  and sp.segment_type like '%PARTITION%'
  and round((sp.bytes)/1024/1024) > 10
  AND (  round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) > 50 
AND (((1 - ROUND ((round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) > 20 )
  ORDER BY frg_pct desc;
  
  
-- for partition tables to find fragmentation above 30%  
select p.table_owner owner,p.table_name table_name,p.partition_name partition_name,p.tablespace_name tablespace,
p.last_analyzed last_analyzed,round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) USED_MB, (sp.bytes)/1024/1024 ALLOC_MB,round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) frg_mb,(((1 - ROUND (( ((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) frg_pct
FROM dba_tab_partitions p,dba_segments sp
where P.TABLE_NAME=SP.SEGMENT_NAME and P.PARTITION_NAME=SP.PARTITION_NAME and P.TABLE_OWNER=SP.OWNER
and p.table_owner not in ('PUBLIC','WMSYS','CTXSYS','DBSNMP','MDDATA','MDSYS','OLAPSYS','ORDPLUGINS','ORDSYS','OUTLN','SI_INFORMTN_SCHEMA','SYS','SYSMAN','SYSTEM','DMSYS','XDB','KPMS','HR','OE','OC','PM','IX','SH','CSMIG','PERFSTAT','EXFSYS','TSMSYS','DBASPOT2','ASGDBASPOT2','DBASPOT1','ASGDBASPOT1','DERBYDBA','OWBSYS','APPQOSSYS','FLOWS_FILES','FLOWS_030000','DDL_AUDITING','WKSYS','WK_TEST','FLOWS_030000','DDL_AUDITING','WKSYS','WK_TEST','DVSYS','LBACSYS','ORDDATA','OJVMSYS','GSMADMIN_INTERNAL','AUDSYS','SQLTXPLAIN') and p.table_owner not like 'APEX%'
and p.table_owner like '%' and sp.segment_type like '%PARTITION%'
and round((sp.bytes)/1024/1024) > 10
AND (round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) > 50
AND (((1 - ROUND ((round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) > 30 )
ORDER BY frg_pct desc;

-- fragmentation 
select owner,
       table_name,
       round((blocks * 8), 2) || 'kb' "Fragmented size",
       round((num_rows * avg_row_len / 1024), 2) || 'kb' "Actual size",
       round((blocks * 8), 2) - round((num_rows * avg_row_len / 1024), 2) || 'kb',
       ((round((blocks * 8), 2) - round((num_rows * avg_row_len / 1024), 2)) /
       round((blocks * 8), 2)) * 100 - 10 "reclaimable space % "
  from dba_tables
 where table_name = '&table_Name';
 
 
-- fragmentation using sql id 
select t.owner owner,t.table_name table_name,t.tablespace_name tablespace,
t.last_analyzed last_analyzed,round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) USED_MB,
round((st.bytes)/1024/1024) ALLOC_MB,
round((st.bytes)/1024/1024 - (t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024 ) frg_mb,
(((1 - ROUND (( ((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) / round((st.bytes)/1024/1024)), 2)) * 100)) frg_pct
FROM dba_tables t,dba_segments st
WHERE t.owner like '%' and t.partitioned='NO'
and T.OWNER=ST.OWNER and T.TABLE_NAME=ST.SEGMENT_NAME
--and t.owner in ('BB_INTERFACE')
and t.table_name in(select * from (
select distinct case "OPERATION" when 'TABLE ACCESS' then object_name
        when 'INDEX ACCESS' then (select table_name from dba_indexes where index_name=object_name and owner=object_owner)
        end "TABLES"
from gv$sql_plan where sql_id='3jw55q9c8agc0') where tables is not null)
and round((st.bytes)/1024/1024) > 10
AND (round((st.bytes)/1024/1024 - (t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024 ) > 50
AND (((1 - ROUND ((round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) / round((st.bytes)/1024/1024)), 2)) * 100)) > 20 )
--and l.sql_id='7uv793av71qf5'
ORDER BY frg_pct desc; 


-- to find tables and indexes used in sql id
select * from (
select distinct case "OPERATION" when 'TABLE ACCESS' then object_name
        when 'INDEX ACCESS' then (select table_name from dba_indexes where index_name=object_name and owner=object_owner)
        end "TABLES"
from gv$sql_plan where sql_id='0x6ktwuy30n1f') where tables is not null ;



Non Partitioned tables :- 

select t.table_name table_name,t.tablespace_name tablespace,t.partitioned,st.partition_name,
    t.last_analyzed last_analyzed,round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) USED_MB,
    round((st.bytes)/1024/1024) ALLOC_MB,
    round((st.bytes)/1024/1024 - (t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024 ) frg_mb,
    (((1 - ROUND (( ((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) / round((st.bytes)/1024/1024)), 2)) * 100)) frg_pct
    FROM  user_tables t,user_segments st
    WHERE  t.partitioned='NO'
    and  T.TABLE_NAME=ST.SEGMENT_NAME
    and round((st.bytes)/1024/1024) > 10
    AND (  round((st.bytes)/1024/1024 - (t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024 ) > 50
    AND (((1 - ROUND ((round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) / round((st.bytes)/1024/1024)), 2)) * 100)) > 30 )
    AND round((t.NUM_ROWS*t.AVG_ROW_LEN)/1024/1024) > 200
    ORDER BY frg_pct desc;


Partitioned table :- 


select p.table_name table_name,p.partition_name partition_name,p.tablespace_name tablespace,
    p.last_analyzed last_analyzed,round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) USED_MB, (sp.bytes)/1024/1024 ALLOC_MB,    round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) frg_mb,  (((1 - ROUND (( ((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) frg_pct
    FROM  user_tab_partitions p,user_segments sp
    where P.TABLE_NAME=SP.SEGMENT_NAME and P.PARTITION_NAME=SP.PARTITION_NAME 
    and  sp.segment_type like '%PARTITION%'
    and round((sp.bytes)/1024/1024) > 10
    AND (  round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) > 50
    AND (((1 - ROUND ((round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) > 30 )
    ORDER BY frg_pct desc;
	
	
	
	
	select p.table_owner owner,p.table_name table_name,p.partition_name partition_name,p.tablespace_name tablespace,
p.last_analyzed last_analyzed,round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) USED_MB,
(sp.bytes)/1024/1024 ALLOC_MB,
round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) frg_mb,
(((1 - ROUND (( ((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) frg_pct
FROM  dba_tab_partitions p,dba_segments sp
  where P.TABLE_NAME=SP.SEGMENT_NAME and P.PARTITION_NAME=SP.PARTITION_NAME and P.TABLE_OWNER=SP.OWNER
  and p.table_owner not in ('PUBLIC','WMSYS','CTXSYS','DBSNMP','MDDATA','MDSYS','OLAPSYS','ORDPLUGINS','ORDSYS','OUTLN','SI_INFORMTN_SCHEMA','SYS','SYSMAN','SYSTEM','DM
SYS','XDB','KPMS','HR','OE','OC','PM','IX','SH','CSMIG','PERFSTAT','EXFSYS','TSMSYS','DBASPOT2','ASGDBASPOT2','DBASPOT1','ASGDBASPOT1','DERBYDBA','OWBSYS','APPQOSSYS','FLOWS_FILES') and p.table_owner not like 'APEX%'
  and p.table_owner like '%'  and sp.segment_type like '%PARTITION%'
  and round((sp.bytes)/1024/1024) > 10
  AND (  round((sp.bytes)/1024/1024 - (p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024 ) > 50 
AND (((1 - ROUND ((round((p.NUM_ROWS*p.AVG_ROW_LEN)/1024/1024) / round((sp.bytes)/1024/1024)), 2)) * 100)) > 20 )
  ORDER BY frg_pct desc;



