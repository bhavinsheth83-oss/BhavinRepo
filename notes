//Get report of SQL executions during the AWR duration. Use the first and last snap ID from AWR report captured.

spool sql_exec.log
col begin_interval for a17
col exec justify right for a7
col "gets/exec" for 999999999
col "PRs/exec" for 9999999
col "rows/exec" for 99999999
col "sec/exec" for 9999.99
col schema for a10
col plan for 9999999999
col module for a20
select a.sql_id,to_char(begin_interval_time,'DD/MM/YYYY Hh24:MI') begin_interval,
decode(executions_delta,0,'**',executions_delta) exec,
plan_hash_value plan,
buffer_gets_delta/decode(executions_delta,0,1,executions_delta) "gets/exec" ,
disk_reads_delta/decode(executions_delta,0,1,executions_delta) "PRs/exec" ,
rows_processed_delta/decode(executions_delta,0,1,executions_delta) "rows/exec",
(elapsed_time_delta/1000000)/decode(executions_delta,0,1,executions_delta) "sec/exec",
a.snap_id, a.parsing_schema_name schema, module
from dba_hist_sqlstat a , dba_hist_snapshot b
where a.snap_id=b.snap_id and (b.snap_id between &first_snap and &last_snap )
and a.parsing_schema_name not in (
'SYS','SYSTEM','DBSNMP','TSMSYS','OUTLN','MDSYS','SYSMAN','OLAPSYS','ORDDATA','XDB','CTXSYS','WMSYS','EXFSYS','ORDSYS','APPQOSSYS','OWBSYS','FLOWS_FILES','SCOTT')
and
(elapsed_time_delta/1000000)/decode(executions_delta,0,1,executions_delta) > 30
order by begin_interval_time;
spool off

