// To find long running SQL using below command

select a.sid,a.serial#,a.status,substr(a.username,1,15),'INATANACE'||a.INST_ID INSTANCE_NUMBER,to_char(LOGON_TIME,'DD-MON-YYYY HH24:MI:SS') Login,substr(a.machine,1,15)
,SQL_ID,a.SERVICE_NAME,last_call_et/60 ET_mins
from gv$session a,gv$sess_io b where a.sid=b.sid  and a.INST_ID=b.INST_ID and  a.username is not null and a.username not in ('GGADMIN','SYS','RAT_CCC_USER') and a.status='ACTIVE' order by last_call_et/60;




select a.INST_ID INS,a.sid,a.serial#,a.status,a.USERNAME,a.osuser,to_char(LOGON_TIME,'DD-MON-YY HH24:MI:SS') Login,a.MACHINE,SQL_ID,a.event,round(last_call_et/60,2) ET_mi
from gv$session a,gv$sess_io b where a.sid=b.sid  and a.INST_ID=b.INST_ID and  a.username is not null and  a.status='ACTIVE'
--and a.username like '%604872225%'
and a.username not in ('GGADMIN','GGS_OWNER')
and a.sql_id is not NULL
--and a.username in ('AMHOME','AMSTAGE','SIEBEL')
order by last_call_et/60 desc; 

// constraint dependencies
select
 a.owner||'.'||a.table_name "Referenced Table"
,b.owner||'.'||b.table_name "Referenced by"
,b.constraint_name "Foreign Key"
from all_constraints a, all_constraints b 
where 
b.constraint_type = 'R'
and a.constraint_name = b.r_constraint_name 
and b.table_name='XXXXXXXXXXXX' -- Table name 
order by a.owner||'.'||a.table_name;

// to disable constraint with cascade option
alter table location disable constraint LOC_PK cascade;


// To find history 
select to_char(begin_interval_time,'DD/MM/YYYY HH24:MI') TIME,PARSING_SCHEMA_NAME USERNAME,sql_id,executions_delta Execution,
round(buffer_gets_delta/executions_delta) BG_PER_E,round(DISK_READS_DELTA/executions_delta) PR_E,plan_hash_value,
round(rows_processed_delta/executions_delta) ROWS_PER_E,b.INSTANCE_NUMBER,(ELAPSED_TIME_DELTA/executions_delta)/1000000 ET_SECS from 
dba_hist_sqlstat A ,dba_hist_snapshot b where sql_id='<&sql_id>' and a.snap_id=b.snap_id and executions_delta > 0 order by begin_interval_time;


// To find blocking sessions


select s1.username || '@' || s1.machine
|| ' ( SID=' || s1.sid || ' from Inst='|| s1.inst_id||')  is blocking '
|| s2.username || '@' || s2.machine || ' ( SID=' || s2.sid || ' of Inst='||s2.inst_id||' ) ' AS blocking_status
from gv$lock l1, gv$session s1, gv$lock l2, gv$session s2
where s1.sid=l1.sid and s2.sid=l2.sid
and s1.inst_id=l1.inst_id and s2.inst_id=l2.inst_id
and l1.BLOCK=1 and l2.request > 0
and l1.id1 = l2.id1
and l2.id2 = l2.id2;


select s1.username || '@' || s1.machine
|| ' ( SID=' || s1.sid || ' Serial=' || s1.serial# || ' SQL_ID=' || s1.SQL_ID || ' from Inst='|| s1.inst_id||')  is blocking '
|| s2.username || '@' || s2.machine || ' ( SID=' || s2.sid || ' Serial=' || s2.serial# || ' SQL_ID=' || s1.SQL_ID || ' of Inst='||s2.inst_id||' ) ' AS blocking_status
from gv$lock l1, gv$session s1, gv$lock l2, gv$session s2
where s1.sid=l1.sid and s2.sid=l2.sid
and s1.inst_id=l1.inst_id and s2.inst_id=l2.inst_id
and l1.BLOCK=1 and l2.request > 0
and l1.id1 = l2.id1
and l2.id2 = l2.id2;


SELECT SES.SID, SES.SERIAL# SER#, SES.PROCESS OS_ID, SES.STATUS, SQL.SQL_FULLTEXT
FROM V$SESSION SES, V$SQL SQL, V$PROCESS PRC
WHERE
   SES.SQL_ID=SQL.SQL_ID AND
   SES.SQL_HASH_VALUE=SQL.HASH_VALUE AND 
   SES.PADDR=PRC.ADDR AND
   SES.SID=&Enter_blocked_session_SID;


This script will query the  dba_lock and dba_blockers view to locate a blocking session:

SELECT 
      a.session_id, 
      username, 
      type, 
      mode_held, 
      mode_requested,
      lock_id1, 
      lock_id2 
FROM
      sys.v_$session b, 
      sys.dba_blockers c, 
      sys.dba_lock a
WHERE
      c.holding_session=a.session_id and
      c.holding_session=b.sid;




Example script to report on blocking locks

SELECT 
       holding_session bsession_id, 
      waiting_session wsession_id, 
      b.username busername, 
      a.username wusername, 
      c.lock_type type, 
      mode_held, mode_requested,
      lock_id1, lock_id2 
FROM
sys.v_$session b, sys.dba_waiters c, sys.v_$session a 
WHERE
c.holding_session=b.sid and
c.waiting_session=a.sid;





select ss.snap_id, ss.instance_number node, begin_interval_time, sql_id, plan_hash_value,
nvl(executions_delta,0) execs,
(elapsed_time_delta/decode(nvl(executions_delta,0),0,1,executions_delta))/1000000 avg_etime,
(buffer_gets_delta/decode(nvl(buffer_gets_delta,0),0,1,executions_delta)) avg_lio
from DBA_HIST_SQLSTAT S, DBA_HIST_SNAPSHOT SS
where sql_id = 'dgnnrnrnsx3ga'
and ss.snap_id = S.snap_id
and ss.instance_number = S.instance_number
and executions_delta > 0
order by 1, 2, 3; 




