// To know the size of database

select sum(bytes)/1024/1024 "MB", sum(bytes)/1024/1024/1024 "GB", sum(bytes)/1024/1024/1024/1024 "TB" from dba_data_files; 

// To know Schema size 
SELECT sum(bytes)/1024/1024 "MB", sum(bytes)/1024/1024/1024 "GB", sum(bytes)/1024/1024/1024/1024 "TB"
from dba_segments
WHERE owner = 'INVENTORY'; 

// to know datafile size and free space
SELECT SUBSTR (df.NAME, 1, 40) file_name, df.bytes / 1024 / 1024 allocated_mb, ((df.bytes / 1024 / 1024) - NVL (SUM (dfs.bytes) / 1024 / 1024, 0)) used_mb,
NVL (SUM (dfs.bytes) / 1024 / 1024, 0) free_space_mb
FROM gv$datafile df, dba_free_space dfs
WHERE df.file# = dfs.file_id(+)
GROUP BY dfs.file_id, df.NAME, df.file#, df.bytes
ORDER BY file_name;
 
 
